/* Same map as fw/board/at32f403a_app.ld: the stock bootloader owns 0x08000000-0x08002FFF and jumps here;
 * 0x080F0000 up (stock marker sector) is left alone. */
MEMORY
{
  FLASH : ORIGIN = 0x08003000, LENGTH = 948K
  RAM   : ORIGIN = 0x20000000, LENGTH = 96K
}

/* Code starts after the model tag, which must sit at 0x080033E0 (image offset 0x3E0). */
_stext = ORIGIN(FLASH) + 0x400;

SECTIONS
{
  .model_tag ORIGIN(FLASH) + 0x3E0 :
  {
    KEEP(*(.model_tag));
  } > FLASH
} INSERT AFTER .vector_table;

/* Font and logo data (`.slow_rodata`, generated by tools/mkassets.py) goes after all code and other constants,
 * so it is what crosses 0x08040000 first as the image grows: the AT32F403A runs code at full speed only from
 * the first 256 KB (docs/firmware-design.md, "MCU flash"). The image stays one contiguous binary for the
 * bootloader: no gap, no padding. */
SECTIONS
{
  .slow_rodata : ALIGN(4)
  {
    __sslow_rodata = .;
    *(.slow_rodata .slow_rodata.*);
    . = ALIGN(4);
    __eslow_rodata = .;
  } > FLASH
} INSERT AFTER .rodata;

/* Code and the other constants must end inside the zero-wait region (0x08000000 + 256 KB). */
ASSERT(__erodata <= 0x08040000, "code and constants run past the 256 KB zero-wait flash");
